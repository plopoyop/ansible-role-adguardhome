# {{ ansible_managed }}
[Unit]
Description=AdGuard Home DNS server
ConditionFileIsExecutable={{ adguardhome_executable_path }}
ConditionPathExists={{ adguardhome_config_file_path }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ adguardhome_system_user }}
Group={{ adguardhome_system_group }}
WorkingDirectory={{ adguardhome_data_path }}
# Updates are managed by Ansible (adguardhome_version).
ExecStart={{ adguardhome_executable_path }} --config {{ adguardhome_config_file_path }} --work-dir {{ adguardhome_data_path }} --no-check-update
Restart=on-failure
RestartSec=5
# Bind DNS (53) / DHCP (67) without root; NET_RAW is needed by the DHCP server.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ adguardhome_config_path }} {{ adguardhome_data_path }}
SyslogIdentifier=adguardhome

[Install]
WantedBy=multi-user.target
